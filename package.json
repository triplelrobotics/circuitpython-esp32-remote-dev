{
  "name": "circuitpython-remote",
  "displayName": "CircuitPython Remote",
  "description": "A lightweight wireless CircuitPython filesystem for VS Code.",
  "version": "0.0.1",
  "publisher": "triplelrobotics",
  "author": "triplelrobotics",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:circuitpythonRemote.discover",
    "onView:circuitpythonRemote.files"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "circuitpythonRemote.discover",
        "title": "CircuitPython Remote: Discover Device"
      },
      {
        "command": "circuitpythonRemote.selectDevice",
        "title": "CircuitPython Remote: Select Device",
        "icon": "$(plug)"
      },
      {
        "command": "circuitpythonRemote.refresh",
        "title": "CircuitPython Remote: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "circuitpythonRemote.newFile",
        "title": "CircuitPython Remote: New File",
        "icon": "$(new-file)"
      },
      {
        "command": "circuitpythonRemote.deleteFile",
        "title": "CircuitPython Remote: Delete File",
        "icon": "$(trash)"
      },
      {
        "command": "circuitpythonRemote.renameFile",
        "title": "CircuitPython Remote: Rename File",
        "icon": "$(edit)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "circuitpythonRemote.files",
          "name": "CircuitPython Remote",
          "icon": "$(remote-explorer)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "circuitpythonRemote.files",
        "contents": "Select a discovered CircuitPython device to browse its files.\n[Select Device](command:circuitpythonRemote.selectDevice)",
        "when": "!circuitpythonRemote.deviceSelected"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "circuitpythonRemote.selectDevice",
          "when": "view == circuitpythonRemote.files",
          "group": "navigation@1"
        },
        {
          "command": "circuitpythonRemote.refresh",
          "when": "view == circuitpythonRemote.files && circuitpythonRemote.deviceSelected",
          "group": "navigation@2"
        },
        {
          "command": "circuitpythonRemote.newFile",
          "when": "view == circuitpythonRemote.files && circuitpythonRemote.deviceSelected",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "circuitpythonRemote.newFile",
          "when": "view == circuitpythonRemote.files && viewItem == remoteDirectory",
          "group": "1_modification@1"
        },
        {
          "command": "circuitpythonRemote.deleteFile",
          "when": "view == circuitpythonRemote.files && viewItem == remoteFile",
          "group": "1_modification@2"
        },
        {
          "command": "circuitpythonRemote.renameFile",
          "when": "view == circuitpythonRemote.files && viewItem == remoteFile",
          "group": "1_modification@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2"
  }
}
